{
  "name": "g4-resonance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "sim": "node scripts/run-balance.mjs",
    "build:parity": "tsc --noEmit && npm --prefix drafts/3d-web run build:parity",
    "verify:parity": "npm --prefix drafts/3d-web run verify:parity",
    "build:polish": "tsc --noEmit && npm --prefix drafts/3d-web run build:polish",
    "verify:polish": "npm --prefix drafts/3d-web run verify:polish",
    "build:smooth": "tsc --noEmit && npm --prefix drafts/3d-web run build:smooth",
    "verify:smooth": "npm --prefix drafts/3d-web run verify:smooth"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
